package templates

import "fmt"

type HomeData struct {
	Title       string
	Version     string // e.g. "v1.0.0" — pass from your server's build info
	InstallCmd  string // e.g. `curl -fsSL https://akpa.victorabuka.com/install.sh | bash`
	GitHubURL   string
	LiveTunnels int
}

templ Home(data HomeData) {
	<!DOCTYPE html>
	<html lang="en" class="scroll-smooth">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.Title }</title>
			<meta name="description" content="akpa exposes a folder on your machine to the internet over one link. No account, no config, no port forwarding."/>
			<meta property="og:title" content="akpa — share a folder over one link"/>
			<meta property="og:description" content="Run akpa in any directory. Get a URL. Anyone can open it."/>
			<meta property="og:type" content="website"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<link rel="icon" href="/static/favicon.ico"/>
		</head>
		<body class="min-h-screen bg-[#f8f4ec] text-[#1c1917] antialiased selection:bg-amber-200">
			<!-- ── nav ─────────────────────────────────────────────── -->
			<nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-6">
				<a href="/" class="font-mono text-lg font-bold tracking-tight">akpa</a>
				<div class="flex items-center gap-6 text-sm text-stone-600">
					<a href="#how" class="transition hover:text-stone-900">How it works</a>
					<a href="#faq" class="transition hover:text-stone-900">FAQ</a>
					<a href={ templ.SafeURL(data.GitHubURL) } class="transition hover:text-stone-900">GitHub</a>
				</div>
			</nav>

			<!-- ── hero ────────────────────────────────────────────── -->
			<header class="mx-auto max-w-3xl px-6 pb-12 pt-16 text-center sm:pt-24">
				<div class="mb-8 flex justify-center">
					<div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-amber-400 text-4xl shadow-sm">
						🎒
					</div>
				</div>
				<h1 class="text-5xl font-extrabold tracking-tight sm:text-6xl">akpa</h1>
				<p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-stone-600">
					Share a folder on your machine over a single link.
					No account, no config, no port forwarding.
				</p>

				<!-- install box -->
				<div class="mt-10">
					<p class="mb-3 text-sm font-semibold uppercase tracking-wider text-stone-500">
						Install
					</p>
					<div
						class="group relative mx-auto flex max-w-2xl items-center gap-3 rounded-xl border border-stone-300/80 bg-white px-5 py-4 text-left shadow-sm"
					>
						<span class="select-none font-mono text-sm text-stone-400">$</span>
						<code id="install-cmd" class="flex-1 overflow-x-auto whitespace-nowrap font-mono text-sm text-stone-800">
							{ data.InstallCmd }
						</code>
						<button
							type="button"
							data-copy-target="install-cmd"
							class="shrink-0 rounded-lg border border-stone-300 px-3 py-1.5 font-mono text-xs text-stone-600 transition hover:bg-stone-100 active:scale-95"
							aria-label="Copy install command"
						>
							copy
						</button>
					</div>
					<p class="mt-3 text-xs text-stone-500">
						macOS and Linux &middot; { data.Version }
						&middot;
						<a href="/install.sh" class="underline underline-offset-2 hover:text-stone-700">read the script</a>
						&middot;
						<a href={ templ.SafeURL(data.GitHubURL + "/releases") } class="underline underline-offset-2 hover:text-stone-700">
							download a binary
						</a>
					</p>
				</div>
			</header>

			<!-- ── how it works ────────────────────────────────────── -->
			<section id="how" class="mx-auto max-w-4xl px-6 py-16">
				<h2 class="mb-10 text-center text-2xl font-bold tracking-tight">How it works</h2>
				<ol class="grid gap-8 sm:grid-cols-3">
					@step("1", "Run it", "cd into any folder and run akpa. It starts a file server on your machine.")
					@step("2", "Get a link", "akpa opens one connection to the relay and prints a URL you can share.")
					@step("3", "They open it", "Requests to that URL are forwarded down to your machine and answered locally.")
				</ol>

				<div class="mt-12 overflow-hidden rounded-xl border border-stone-300/80 bg-[#1c1917] shadow-sm">
					<div class="flex items-center gap-2 border-b border-stone-700 px-4 py-3">
						<span class="h-3 w-3 rounded-full bg-red-400"></span>
						<span class="h-3 w-3 rounded-full bg-amber-400"></span>
						<span class="h-3 w-3 rounded-full bg-green-400"></span>
					</div>
					<pre class="overflow-x-auto p-5 font-mono text-sm leading-relaxed text-stone-200"><code>$ cd ~/photos
$ akpa

  serving  ~/photos
  link     https://akpa.victorabuka.com/live/hdy2yuyh63hhdh

  ready. ctrl-c to stop.
</code></pre>
				</div>
			</section>

			<!-- ── faq ─────────────────────────────────────────────── -->
			<section id="faq" class="mx-auto max-w-2xl px-6 py-16">
				<h2 class="mb-10 text-center text-2xl font-bold tracking-tight">FAQ</h2>
				<dl class="space-y-8">
					@faq("Who can see my files?",
						"Anyone with the link. The ID is random and long enough that guessing is impractical, but treat the link itself as the password. The tunnel disappears the moment you stop akpa.")
					@faq("Do I need to open a port?",
						"No. akpa dials out to the relay, so it works behind NAT, CGNAT, and university or office firewalls that block inbound connections.")
					@faq("How do I update?",
						"Run akpa upgrade. It fetches the same installer and replaces the binary in place.")
					@faq("How do I uninstall?",
						"Delete the binary. akpa writes nothing else to your machine.")
				</dl>
			</section>

			<!-- ── footer ──────────────────────────────────────────── -->
			<footer class="border-t border-stone-300/60">
				<div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-stone-500 sm:flex-row">
					<p>
						Built by
						<a href="https://victorabuka.com" class="underline underline-offset-2 hover:text-stone-700">Victor Abuka</a>
					</p>
					<div class="flex items-center gap-5">
						if data.LiveTunnels > 0 {
							<span class="flex items-center gap-2">
								<span class="h-2 w-2 rounded-full bg-green-500"></span>
								{ fmt.Sprint(data.LiveTunnels) } live
							</span>
						}
						<a href={ templ.SafeURL(data.GitHubURL) } class="hover:text-stone-700">GitHub</a>
						<a href="/healthz" class="hover:text-stone-700">Status</a>
					</div>
				</div>
			</footer>

			<script src="/static/js/copy.js" defer></script>
		</body>
	</html>
}

templ step(n, title, body string) {
	<li class="text-center">
		<div class="mx-auto mb-4 flex h-9 w-9 items-center justify-center rounded-full bg-amber-400 font-mono text-sm font-bold">
			{ n }
		</div>
		<h3 class="mb-2 font-semibold">{ title }</h3>
		<p class="text-sm leading-relaxed text-stone-600">{ body }</p>
	</li>
}

templ faq(q, a string) {
	<div>
		<dt class="mb-2 font-semibold">{ q }</dt>
		<dd class="text-sm leading-relaxed text-stone-600">{ a }</dd>
	</div>
}
