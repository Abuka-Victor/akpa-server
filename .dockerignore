# Keeps the build context small and stops local junk reaching the image.
.git
.github
.gitignore
.DS_Store
**/.DS_Store

# Never bake secrets into an image. Coolify supplies env vars at runtime.
.env
.env.*

# Build output — regenerated inside the container
node_modules
dist/
akpa-server
static/css/output.css

# Generated by templ inside the container; a stale copy here would be copied
# in and then overwritten, or worse, confuse the build.
templates/*_templ.go

README.md
DEPLOY.md
*.md
